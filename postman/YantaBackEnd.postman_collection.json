{
  "info": {
    "name": "YantaBackEnd",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Customer flow (scan QR -> order -> bill) and staff smoke checks. Set staffJwt to a Supabase access_token for staff calls."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5128"
    },
    {
      "key": "qrToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "unavailableProductId",
      "value": ""
    },
    {
      "key": "sessionToken",
      "value": ""
    },
    {
      "key": "staffJwt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Customer flow",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + connected', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().database).to.eql('connected'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/db",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "db"
              ]
            }
          }
        },
        {
          "name": "Menu - categories (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 list', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Menu - products (public, available only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('no unavailable item', () => pm.expect(pm.response.json().every(p => p.isAvailable)).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Scan - unknown QR -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/scan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "scan"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrToken\": \"00000000-0000-0000-0000-000000000001\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Scan - valid QR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('has token + table', () => { pm.expect(j.sessionToken).to.be.a('string'); pm.expect(j.tableNumber).to.be.a('string'); });",
                  "pm.collectionVariables.set('sessionToken', j.sessionToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/scan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "scan"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrToken\": \"{{qrToken}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Scan again - same session/token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('same token for same table', () => pm.expect(pm.response.json().sessionToken).to.eql(pm.collectionVariables.get('sessionToken')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/scan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "scan"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrToken\": \"{{qrToken}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Orders - no token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customer/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "orders"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Orders - forged token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Session-Token",
                "value": "00000000000000000000000000000000.forged"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "orders"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Session info",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 active', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('active'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "session"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Order - unavailable item -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{unavailableProductId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Order - empty items -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": []\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Order - create (duplicate lines merge)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const o = pm.response.json();",
                  "pm.test('pending, 1 item, qty 3', () => { pm.expect(o.status).to.eql('pending'); pm.expect(o.items.length).to.eql(1); pm.expect(o.items[0].quantity).to.eql(3); });",
                  "pm.test('total = price x qty', () => pm.expect(o.totalAmount).to.eql(o.items[0].unitPrice * 3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"note\": \"postman\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Order - history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with 1 order', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "orders"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Request bill",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('closing + billRequestedAt', () => { const s = pm.response.json(); pm.expect(s.status).to.eql('closing'); pm.expect(s.billRequestedAt).to.not.be.null; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/bill-request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "bill-request"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Order after bill -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Staff (needs staffJwt)",
      "item": [
        {
          "name": "GET /api/orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 or 200', () => pm.expect([200,401]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffJwt}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/tables",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 or 200', () => pm.expect([200,401]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tables"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffJwt}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 or 200', () => pm.expect([200,401]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffJwt}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/products/all",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 or 200', () => pm.expect([200,401]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "all"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffJwt}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}